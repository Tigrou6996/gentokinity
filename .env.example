# Copie ce fichier en ".env" et remplis les valeurs. Ne commite JAMAIS le fichier .env.
#
# Ce fichier sert au SERVEUR (VPS) et au développement. L'application Windows compilée (npm run build:prod)
# ne contient AUCUNE de ces valeurs : elle relaie le live au serveur, qui garde les secrets.
# Sans .env (ou sans MONGODB_URI), le serveur démarre quand même et l'API répond « Base de données
# indisponible » : la connexion au tableau de bord affiche alors la cause.

# --- Base de données (obligatoire) ---
# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/gentok

# --- Serveur ---
PORT=3000
# URL publique du tableau de bord (utilisée pour Spotify et les retours Stripe)
DASHBOARD_URL=https://tiktok.gentok.fr
# Serveur distant auquel l'application de bureau se connecte
REMOTE_SERVER=https://tiktok.gentok.fr
# NODE_ENV=production

# --- Mode d'exécution (optionnel, détecté automatiquement) ---
# GENTOK_VPS=true   -> force le mode serveur (VPS)
# WEB_MODE=true     -> force le mode web
# APP_MODE=true     -> force le mode application locale

# --- Connexion TikTok (optionnel mais recommandé) ---
# Clé Euler Stream (https://www.eulerstream.com) : augmente la limite de connexions
# TikTok et évite la plupart des échecs "rate limit" / signature. Sur le VPS, elle sert aussi
# à l'application Windows (via /api/sign-proxy) et au compte bot du chat (clé autorisée à
# envoyer des messages). Elle n'est jamais copiée dans l'application.
SIGN_API_KEY=

# --- Paiements Stripe (VPS uniquement) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
