# Copie ce fichier en ".env" et remplis les valeurs. Ne commite JAMAIS le fichier .env.

# --- Base de données (obligatoire) ---
# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/gentok

# --- Serveur ---
PORT=3000
# URL publique du tableau de bord (utilisée pour Spotify et les retours Stripe)
DASHBOARD_URL=https://tiktok.gentok.fr
# Serveur distant auquel l'application de bureau se connecte
REMOTE_SERVER=https://tiktok.gentok.fr
# NODE_ENV=production

# --- Mode d'exécution (optionnel, détecté automatiquement) ---
# GENTOK_VPS=true   -> force le mode serveur (VPS)
# WEB_MODE=true     -> force le mode web
# APP_MODE=true     -> force le mode application locale

# --- Paiements Stripe (VPS uniquement) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
